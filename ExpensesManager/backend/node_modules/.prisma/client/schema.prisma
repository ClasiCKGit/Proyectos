generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ─────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  name         String   @db.VarChar(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  recurringTransactions RecurringTransaction[]
  transactions          Transaction[]
  budgets               Budget[]
  savingsGoals          SavingsGoal[]
  refreshTokens         RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(512)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── EXPENSE MANAGER ─────────────────────────────────────────────────────────

model Transaction {
  id                     String                @id @default(uuid())
  type                   TransactionType
  amount                 Decimal               @db.Decimal(12, 2)
  description            String                @db.VarChar(100)
  category               Category
  date                   DateTime              @db.Date
  notes                  String?               @db.Text
  recurrence             RecurrenceType        @default(none)
  userId                 String
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringTransactionId String?
  recurringTransaction   RecurringTransaction? @relation("GeneratedByRecurring", fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  tags TransactionTag[]

  savingsGoalId String?
  savingsGoal   SavingsGoal? @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, category])
  @@map("transactions")
}

model TransactionTag {
  id            String      @id @default(uuid())
  tag           String      @db.VarChar(50)
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("transaction_tags")
}

model Budget {
  id        String       @id @default(uuid())
  category  Category
  limit     Decimal      @db.Decimal(12, 2)
  period    BudgetPeriod @default(monthly)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, category])
  @@map("budgets")
}

model SavingsGoal {
  id            String    @id @default(uuid())
  name          String    @db.VarChar(100)
  targetAmount  Decimal   @db.Decimal(12, 2)
  currentAmount Decimal   @default(0) @db.Decimal(12, 2)
  deadline      DateTime? @db.Date
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  transactions Transaction[]

  @@map("savings_goals")
}

model RecurringTransaction {
  id          String          @id @default(uuid())
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  description String          @db.VarChar(100)
  category    Category
  notes       String?         @db.Text
  recurrence  RecurrenceType // daily | weekly | monthly | yearly
  startDate   DateTime        @db.Date
  endDate     DateTime?       @db.Date // null = sin vencimiento
  nextDueDate DateTime        @db.Date // próxima fecha a procesar
  lastRunAt   DateTime? // última vez que se procesó
  isActive    Boolean         @default(true)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tags      RecurringTransactionTag[]
  generated Transaction[]             @relation("GeneratedByRecurring")

  @@index([userId, isActive])
  @@index([nextDueDate, isActive])
  @@map("recurring_transactions")
}

model RecurringTransactionTag {
  id                     String               @id @default(uuid())
  tag                    String               @db.VarChar(50)
  recurringTransactionId String
  recurringTransaction   RecurringTransaction @relation(fields: [recurringTransactionId], references: [id], onDelete: Cascade)

  @@index([recurringTransactionId])
  @@map("recurring_transaction_tags")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum TransactionType {
  income
  expense
}

enum Category {
  housing
  food
  transport
  health
  entertainment
  education
  clothing
  savings
  other
}

enum RecurrenceType {
  none
  daily
  weekly
  monthly
  yearly
}

enum BudgetPeriod {
  monthly
  yearly
}
